 validation_status     | text                     |           |          | 
 error                 | text                     |           |          | 
Indexes:
    "ai_execution_pkey" PRIMARY KEY, btree (id)
    "ix_ai_execution_conversation_id" btree (conversation_id)
Check constraints:
    "ck_ai_execution_task" CHECK (task::text = ANY (ARRAY['INTENT_CLASSIFICATION'::character varying, 'SERVICES_CLASSIFICATION'::character varying, 'EVENT_TYPE_EXTRACTION'::character varying, 'RECEIPT_EXTRACTION'::character varying]::text[]))
    "ck_ai_execution_validation_status" CHECK (validation_status = ANY (ARRAY['VALID'::text, 'NORMALIZED'::text, 'INVALID_SCHEMA'::text, 'DISCARDED'::text, 'HTTP_ERROR'::text]))
Foreign-key constraints:
    "ai_execution_conversation_id_fkey" FOREIGN KEY (conversation_id) REFERENCES conversation(id)
