                plan.active = False
        await send(harness, PROPOSAL_CATALOG)
        await send(harness, INCIDENT_T2 if inactive else "me interesa cinema y amor")
        await assert_plan_options(harness, "PROPOSAL")
        conversation = await current_conversation(harness)
