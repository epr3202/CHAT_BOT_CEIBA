Indexes:
    "reservation_pkey" PRIMARY KEY, btree (reservation_id)
    "ix_reservation_starts_at_status" btree (starts_at, status)
Check constraints:
    "ck_reservation_paid_nonnegative" CHECK (amount_paid_cop >= 0)
    "ck_reservation_payment_kind" CHECK (payment_kind IS NULL OR (payment_kind::text = ANY (ARRAY['DEPOSIT'::character varying, 'FULL'::character varying]::text[])))
    "ck_reservation_price_positive" CHECK (price_cop > 0)
    "ck_reservation_status" CHECK (status::text = ANY (ARRAY['PAYMENT_PENDING'::character varying, 'PAYMENT_REVIEW'::character varying, 'RESERVED'::character varying, 'EXPIRED'::character varying, 'CANCELLED'::character varying]::text[]))
    "ck_reservation_time_range" CHECK (ends_at > starts_at)
