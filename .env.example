# Aplicacion
ENVIRONMENT=development
LOG_LEVEL=INFO
HUMAN_HOURS_DAYS=1,2,3,4,5
HUMAN_HOURS_START=08:00
HUMAN_HOURS_END=16:00

# Login de administracion: fallos por documento dentro de la ventana
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_WINDOW_MINUTES=15

# Base de datos
DATABASE_URL=postgresql+asyncpg://ceiba:ceiba@localhost:5432/ceiba
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Meta / WhatsApp Cloud API
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_GRAPH_API_VERSION=v20.0
WHATSAPP_API_BASE_URL=https://graph.facebook.com

# Webhook
WEBHOOK_MAX_BODY_BYTES=1048576

# Worker de outbox
OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_BATCH_SIZE=10
OUTBOX_SENDING_TIMEOUT_SECONDS=120
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_MAX_BACKOFF_SECONDS=300

# Evidencias de pago (Nivel 1)
PAYMENT_EVIDENCE_DIR=/data/payment-evidence
PAYMENT_EVIDENCE_RETENTION_DAYS=365
PAYMENT_REVIEW_AI_ENABLED=false
OPENROUTER_MODEL_VISION=google/gemini-2.5-flash-lite
PAYMENT_REVIEW_CONFIDENCE_OK=0.80
PAYMENT_REVIEW_CONFIDENCE_MIN=0.50
PAYMENT_REVIEW_MAX_ATTEMPTS=2

# Calendario de visitas
# Proveedor de calendario: fake para local/tests, google para producción.
CALENDAR_ADAPTER=fake
SELF_SERVICE_BOOKING_ENABLED=false
# Required before publishing the booking payment instructions (empty by default).
BOOKING_BANK_NAME=
BOOKING_ACCOUNT_TYPE=
BOOKING_ACCOUNT_NUMBER=
BOOKING_ACCOUNT_HOLDER=
BOOKING_EXCLUSIVITY_KEYWORD=exclusividad
BOOKING_HOURS_START=12:00
BOOKING_LATEST_START=21:00
BOOKING_HOURS_END=24:00
BOOKING_MIN_LEAD_DAYS=1
BOOKING_DEPOSIT_PERCENT=50

# Avisos internos a asesores: activar después de migrar y configurar destinatarios.
STAFF_NOTIFICATIONS_ENABLED=false
STAFF_TEMPLATE_EVIDENCE_NAME=
STAFF_TEMPLATE_PENDING_NAME=
STAFF_TEMPLATE_LANGUAGE=es
STAFF_WINDOW_SAFETY_MINUTES=30
STAFF_DEFERRED_MAX_AGE_HOURS=48
STAFF_OUTBOX_MAX_ATTEMPTS=5
# Calendario Google donde se crean eventos de visitas.
GOOGLE_CALENDAR_ID=visitas-la-ceiba@example.com
# Calendarios Google consultados por freebusy, separados por coma.
GOOGLE_FREEBUSY_CALENDAR_IDS=visitas-la-ceiba@example.com,principal@example.com
# Ruta local al JSON de service account de Google Calendar.
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-service-account.json

# OpenRouter / IA
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_INTENT=
OPENROUTER_MODEL_EXTRACTION=
OPENROUTER_MODEL_DRAFTING=
OPENROUTER_MODEL_SUMMARY=
OPENROUTER_TIMEOUT_SECONDS=15
OPENROUTER_MAX_RETRIES=1
AI_PROMPT_VERSION=intent_v1
AI_CONFIDENCE_SAFE=0.85
AI_CONFIDENCE_PROBABLE=0.70
AI_CONFIDENCE_UNCERTAIN=0.50
